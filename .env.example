# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# MySQL (never commit real credentials)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/family_notes

# Existing Manus OAuth compatibility
VITE_APP_ID=
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Storage: choose local for a single server or s3 for object storage
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# S3-compatible storage (required only when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
